menu "KobitoKey Haptic"

config KOBITOKEY_HAPTIC
    bool "KobitoKey haptic motor support"
    default y

config KOBITOKEY_HAPTIC_PULSE_MS
    int "KobitoKey haptic pulse duration in milliseconds"
    default 25
    range 1 2000
    depends on KOBITOKEY_HAPTIC

config KOBITOKEY_HAPTIC_COOLDOWN_MS
    int "KobitoKey haptic cooldown in milliseconds"
    default 50
    range 0 2000
    depends on KOBITOKEY_HAPTIC

config KOBITOKEY_HAPTIC_USB_PULSE_MS
    int "KobitoKey USB connection haptic duration in milliseconds"
    default 20
    range 1 2000
    depends on KOBITOKEY_HAPTIC && KOBITOKEY_VBUS_SENSE

config KOBITOKEY_HAPTIC_BOOT_DELAY_MS
    int "KobitoKey boot haptic delay in milliseconds"
    default 500
    range 0 10000
    depends on KOBITOKEY_HAPTIC

config KOBITOKEY_HAPTIC_BOOT_LONG_MS
    int "KobitoKey boot haptic long pulse duration in milliseconds"
    default 20
    range 0 10000
    depends on KOBITOKEY_HAPTIC

config KOBITOKEY_HAPTIC_BOOT_GAP1_MS
    int "KobitoKey boot haptic first gap in milliseconds"
    default 600
    range 0 10000
    depends on KOBITOKEY_HAPTIC

config KOBITOKEY_HAPTIC_BOOT_SHORT_MS
    int "KobitoKey boot haptic short pulse duration in milliseconds"
    default 20
    range 0 10000
    depends on KOBITOKEY_HAPTIC

config KOBITOKEY_HAPTIC_BOOT_GAP2_MS
    int "KobitoKey boot haptic second gap in milliseconds"
    default 150
    range 0 10000
    depends on KOBITOKEY_HAPTIC

endmenu


menu "KobitoKey Fold Sense"

config KOBITOKEY_FOLD_SENSE
    bool "KobitoKey fold-state detection and power-off support"
    default n

config KOBITOKEY_FOLD_DEBOUNCE_MS
    int "Fold-state debounce time in milliseconds"
    default 30
    range 1 1000
    depends on KOBITOKEY_FOLD_SENSE

config KOBITOKEY_FOLD_DIAG_LED
    bool "Latch the RGB LED on a closed fold reading with the lid open"
    default n
    depends on KOBITOKEY_FOLD_SENSE && RGBLED_WIDGET
    help
      Diagnostic aid for a half that switches itself off during use.
      The first closed reading taken while the lid is open lights the
      LED and keeps it lit until the half restarts: red if the haptic
      motor was in use at the time, blue if it had already been still,
      magenta if both have happened.

      Red points at the motor disturbing the sensor, which the settle
      time can be raised to cover. Blue means the sensor reports
      closed with nothing shaking it, which is a hardware matter that
      no firmware change will reach.

      It latches rather than blinks so that seeing nothing is itself
      evidence: a blink can be missed, or painted over by the widget
      driving the same LEDs.

      Leave this off for normal builds.

endmenu



menu "KobitoKey VBUS Sense"

config KOBITOKEY_VBUS_SENSE
    bool "KobitoKey VBUS detection support"
    default y

config KOBITOKEY_VBUS_LOG_BOOT_STATE
    bool "Log VBUS state at boot"
    default y
    depends on KOBITOKEY_VBUS_SENSE

config KOBITOKEY_VBUS_DEBOUNCE_MS
    int "VBUS detection debounce time in milliseconds"
    default 20
    range 0 1000
    depends on KOBITOKEY_VBUS_SENSE

endmenu

menu "KobitoKey Health"

config KOBITOKEY_HEALTH
    bool "Report the boot cause and recover from a hang"
    default n
    select WATCHDOG
    help
      Reads RESETREAS at startup and shows the previous boot cause on
      the RGB LED, then arms a watchdog so a hung half resets itself
      instead of sitting dead until it is power cycled.

      Colours: red watchdog (it hung), green System OFF wake, blue
      reset pin, cyan software reset, magenta lockup, yellow the core
      lost power (brownout or a supply fault).

      Lights on every boot, so an indicator that never appears means
      the indicator is broken rather than the fault being absent.

config KOBITOKEY_HEALTH_SHOW_MS
    int "How long to hold the boot-cause colour, in milliseconds"
    default 3000
    range 200 20000
    depends on KOBITOKEY_HEALTH

config KOBITOKEY_HEALTH_WDT_MS
    int "Watchdog timeout in milliseconds"
    default 8000
    range 1000 60000
    depends on KOBITOKEY_HEALTH

config KOBITOKEY_HEALTH_FEED_MS
    int "How often to feed the watchdog, in milliseconds"
    default 2000
    range 100 30000
    depends on KOBITOKEY_HEALTH

endmenu
