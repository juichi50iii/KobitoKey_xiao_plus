-static void paw32xx_motion_timer_handler(struct k_timer *timer) {
-    struct paw32xx_data *data = CONTAINER_OF(timer, struct paw32xx_data, motion_timer);
-    k_work_submit(&data->motion_work);
+/*
+ * Sampling and reporting are deliberately split into two independent
+ * execution contexts:
+ *
+ * - motion_work (system workqueue): only reads MOTION+DELTA_X+DELTA_Y in
+ *   one SPI transaction and accumulates. It re-enables the level-triggered
+ *   hardware interrupt immediately afterward, every time, so sampling is
+ *   never delayed by anything downstream. This is what let an earlier
+ *   fully-interrupt-driven attempt regress cursor distance: it called
+ *   input_report_rel() (which can block on a full BLE mouse-report queue)
+ *   before re-enabling the interrupt, so a slow send stalled sampling and
+ *   lost real motion.
+ * - report_work (dedicated paw32xx_report_work_q, NOT the shared system
+ *   workqueue): wakes on its own fixed period and drains whatever has
+ *   accumulated. An eager "submit right after every sample" variant was
+ *   tried and reverted: input_report_rel()'s K_NO_WAIT only covers
+ *   Zephyr's own input-event submission, while ZMK's own
+ *   zmk_hog_send_mouse_report() (hog.c) has its own hardcoded
+ *   k_msgq_put(..., K_MSEC(100)) wait we don't control -- and once the BLE
+ *   mouse-report queue has no free slot, waiting roughly one real
+ *   connection interval (measured ~10-20ms) for the next slot is the
+ *   transport's normal behavior, not a rare stall. Submitting eagerly
+ *   layered our own reactive timing on top of that transport-paced
+ *   rhythm and the two fought each other, felt like the cursor
+ *   "braking". A fixed period sidesteps that: it doesn't try to react to
+ *   or out-guess the transport's own cadence.
+ *
+ * If input_report_rel() ends up blocking, that happens on this dedicated
+ * thread only, so it cannot stall motion_work or anything else on the
+ * system workqueue -- accumulation keeps going in the background and the
+ * next tick just picks up whatever has built up since.
+ */
+#define PAW32XX_REPORT_INTERVAL_MS 16
+#define PAW32XX_REPORT_STACK_SIZE 1024
+#define PAW32XX_REPORT_THREAD_PRIORITY CONFIG_SYSTEM_WORKQUEUE_PRIORITY
+
+K_THREAD_STACK_DEFINE(paw32xx_report_stack, PAW32XX_REPORT_STACK_SIZE);
+static struct k_work_q paw32xx_report_work_q;
+
+static void paw32xx_report_work_handler(struct k_work *work) {
+    struct k_work_delayable *dwork = k_work_delayable_from_work(work);
+    struct paw32xx_data *data = CONTAINER_OF(dwork, struct paw32xx_data, report_work);
+    const struct paw32xx_config *cfg = data->dev->config;
+
+    int16_t delta_x = (int16_t)CLAMP(data->accumulated_x, INT16_MIN, INT16_MAX);
+    int16_t delta_y = (int16_t)CLAMP(data->accumulated_y, INT16_MIN, INT16_MAX);
+    const bool have_x = delta_x != 0;
+    const bool have_y = delta_y != 0;
+
+    if (have_x || have_y) {
+        int16_t rot_x = delta_x;
+        int16_t rot_y = delta_y;
+        paw32xx_rotate_xy(&rot_x, &rot_y, cfg->rotation_angle);
+
+        /* Only consume the accumulator on a confirmed send. A failed
+         * send (e.g. the BLE mouse-report queue briefly full) leaves the
+         * un-rotated delta in place so it is included, undiminished, in
+         * the next tick instead of being silently lost. */
+        if (!have_x ||
+            input_report_rel(data->dev, INPUT_REL_X, rot_x, !have_y, K_NO_WAIT) == 0) {
+            data->accumulated_x -= delta_x;
+        }
+        if (!have_y || input_report_rel(data->dev, INPUT_REL_Y, rot_y, true, K_NO_WAIT) == 0) {
+            data->accumulated_y -= delta_y;
+        }
+    }
+
+    k_work_reschedule_for_queue(&paw32xx_report_work_q, &data->report_work,
+                                 K_MSEC(PAW32XX_REPORT_INTERVAL_MS));
 }
 
