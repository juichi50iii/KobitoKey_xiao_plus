+static void paw32xx_recover_motion(struct paw32xx_data *data) {
+    const struct paw32xx_config *cfg = data->dev->config;
+    data->accumulated_x = 0;
+    data->accumulated_y = 0;
+    paw32xx_interrupt_enable(data->dev);
+    if (gpio_pin_get_dt(&cfg->irq_gpio) == 0) {
+        k_timer_start(&data->motion_timer, K_MSEC(1), K_NO_WAIT);
+    }
+}
