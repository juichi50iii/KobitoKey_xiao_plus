+/* Rotate and emit everything accumulated so far, then clear it. */
+static void paw32xx_flush_accumulated(struct paw32xx_data *data) {
+    const struct paw32xx_config *cfg = data->dev->config;
+    int16_t x = (int16_t)CLAMP(data->accumulated_x, INT16_MIN, INT16_MAX);
+    int16_t y = (int16_t)CLAMP(data->accumulated_y, INT16_MIN, INT16_MAX);
+
+    data->accumulated_x = 0;
+    data->accumulated_y = 0;
+
+    if (x == 0 && y == 0) {
+        return;
+    }
+
+    paw32xx_rotate_xy(&x, &y, cfg->rotation_angle);
+
+    if (x == 0 && y == 0) {
+        return;
+    }
+
+    LOG_DBG("x=%4d y=%4d", x, y);
+
+    input_report_rel(data->dev, INPUT_REL_X, x, false, K_FOREVER);
+    input_report_rel(data->dev, INPUT_REL_Y, y, true, K_FOREVER);
+}
