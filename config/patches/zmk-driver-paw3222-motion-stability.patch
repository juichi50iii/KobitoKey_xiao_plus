+static int paw32xx_enable_12bit_mode(const struct device *dev) {
+    int ret = paw32xx_write_reg(dev, PAW32XX_WRITE_PROTECT, WRITE_PROTECT_DISABLE);
+    if (ret < 0) {
+        return ret;
+    }
+
+    ret = paw32xx_update_reg(dev, PAW32XX_MOUSE_OPTION,
+                             MOUSE_OPTION_12BIT_MODE, MOUSE_OPTION_12BIT_MODE);
+    if (ret < 0) {
+        return ret;
+    }
+
+    return paw32xx_write_reg(dev, PAW32XX_WRITE_PROTECT, WRITE_PROTECT_ENABLE);
+}
+
+static int paw32xx_verify_configuration(const struct device *dev) {
+    const struct paw32xx_config *cfg = dev->config;
+    uint8_t value;
+    int ret = paw32xx_read_reg(dev, PAW32XX_MOUSE_OPTION, &value);
+    if (ret < 0 || (value & MOUSE_OPTION_12BIT_MODE) == 0) {
+        return ret < 0 ? ret : -EIO;
+    }
+
+    ret = paw32xx_read_reg(dev, PAW32XX_CPI_X, &value);
+    if (ret < 0 || value != cfg->res_cpi / RES_STEP) {
+        return ret < 0 ? ret : -EIO;
+    }
+    ret = paw32xx_read_reg(dev, PAW32XX_CPI_Y, &value);
+    if (ret < 0 || value != cfg->res_cpi / RES_STEP) {
+        return ret < 0 ? ret : -EIO;
+    }
+
+    ret = paw32xx_read_reg(dev, PAW32XX_OPERATION_MODE, &value);
+    if (ret < 0 || (cfg->force_awake && (value & OPERATION_MODE_SLP_MASK) != 0)) {
+        return ret < 0 ? ret : -EIO;
+    }
+    return 0;
+}
