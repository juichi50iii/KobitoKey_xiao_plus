+static void paw32xx_report_accumulated(struct paw32xx_data *data) {
+    const struct paw32xx_config *cfg = data->dev->config;
+    int16_t x = (int16_t)CLAMP(data->accumulated_x, INT16_MIN, INT16_MAX);
+    int16_t y = (int16_t)CLAMP(data->accumulated_y, INT16_MIN, INT16_MAX);
+
+    if (x == 0 && y == 0) {
+        return;
+    }
+
+    /* Accumulate sensor-native X/Y first, then rotate the complete report
+     * once. This matches the PMW3610 pipeline and avoids distributing tiny
+     * per-sample values alternately between the two output axes. */
+    data->accumulated_x -= x;
+    data->accumulated_y -= y;
+    paw32xx_rotate_xy(&x, &y, cfg->rotation_angle);
+
+    const bool have_x = x != 0;
+    const bool have_y = y != 0;
+
+    if (have_x) {
+        input_report_rel(data->dev, INPUT_REL_X, x, !have_y, K_NO_WAIT);
+    }
+    if (have_y) {
+        input_report_rel(data->dev, INPUT_REL_Y, y, true, K_NO_WAIT);
+    }
+}
