#include "kobitokey.dtsi"

#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/keys.h>
#include <input/processors.dtsi>
#include <zmk-input-inertia/input/processor/input_inertia.dtsi>

&xiao_serial { status = "disabled"; };

/* 列オフセット */
&default_transform { col-offset = <5>; };

&pinctrl {
    spi0_default_r: spi0_default_r { group1 {
        psels = <NRF_PSEL(SPIM_SCK,  0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
    }; };
    spi0_sleep_r: spi0_sleep_r { group1 {
        psels = <NRF_PSEL(SPIM_SCK,  0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        low-power-enable;
    }; };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default_r>;
    pinctrl-1 = <&spi0_sleep_r>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    tb_right: trackball@0 {
        status = "okay";
        compatible = "pixart,paw3222";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        rotation-angle = <25>;
        movement-threshold = <3>;
    };
};

/ {
    /omit-if-no-ref/ zip_temp_layer: zip_temp_layer {
        compatible = "zmk,input-processor-temp-layer";
        #input-processor-cells = <2>;
        require-prior-idle-ms = <350>;
    };

    haptic_right: haptic_right {
        compatible = "kobitokey,input-processor-haptic-right";
        #input-processor-cells = <0>;
        status = "okay";
    };

    vbus_sense: vbus_sense {
        compatible = "kobitokey,vbus-sense";
        status = "okay";
        gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
    };

    axis_lock: axis_lock {
        compatible = "zmk,input-processor-axis-lock";
        #input-processor-cells = <0>;

        activation-threshold = <12>;
        force-lock-threshold = <20>;
        dominance-per-mille = <2500>;
        release-ms = <75>;
    };

    &zip_inertia {
    // Initiation delay (Wait time after input stops before starting inertia)
    // Recommended: AT LEAST 2x your sensor's polling interval (e.g., 30ms for 15ms sensor).
    trigger-ms = <35>;

    // --- Mouse Movement Settings ---
    move-decay-factor-int = <90>;       // Decay rate (0-100)
    move-report-interval-ms = <35>;     // Report interval (ms)
    move-threshold-start = <15>;        // Start threshold (pix/report)
    move-threshold-stop = <1>;          // Stop threshold (pix/report)

    // --- Scrolling Settings ---
    scroll-decay-factor-int = <85>;    // Scroll decay rate
    scroll-report-interval-ms = <65>;  // Scroll report interval (ms)
    scroll-threshold-start = <2>;      // Start threshold (pix/report)
    scroll-threshold-stop = <0>;       // Stop threshold (pix/report)

    // Optional: stop/suppress scroll inertia while Ctrl is pressed.
    cancel-scroll-inertia-on-ctrl;
    };
};

&tb_right_listener {
    status = "okay";
    device = <&tb_right>;

    input-processors =
        <&zip_temp_layer 3 5000>,
        <&zip_xy_swap_mapper>,
        <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>;


    scroll {
        layers = <4>;
        input-processors = 
            <&zip_xy_swap_mapper>,
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&axis_lock>,
            <&zip_x_scaler 1 15>,
            <&zip_y_scaler 1 15>,
            <&haptic_right>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_inertia>;
    };

    
    keybind_arrow { 
        layers = <5>;
        input-processors = 
            <&zip_xy_swap_mapper>,
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            <&axis_lock>,
            <&zip_x_scaler 1 15>,
            <&zip_y_scaler 1 15>,
            <&haptic_right>,
            <&zip_keybind_keys>;
    };
};


&tb_left_listener {
    status = "okay";
    device = <&tb_left_split>;

    input-processors =
                <&zip_x_scaler 0 1>,
                <&zip_y_scaler 1 15>;
};


&zip_temp_layer {
    excluded-positions = <
        6
        7
        8
        30
        32
        33
        39
    >;
};

/ {
    zip_keybind_keys: zip_keybind_keys {
        compatible = "zmk,input-processor-keybind";
        #input-processor-cells = <0>;
        track_remainders;
        bindings = <&kp LC(LEFT)>,
                   <&kp LC(RIGHT)>,
                   <&kp LC(DOWN)>,
                   <&kp LC(UP)>;
        tick = <3>;
        wait-ms = <0>;
        tap-ms = <10>;
        // mode = <1>
        // threshold = <10>
        // max_threshold = <200>
        // max_pending_activations = <10>
    };
};